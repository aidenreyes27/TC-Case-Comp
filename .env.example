# Copy to .env and fill in. Never commit .env.

# AI end-of-day brief: set ONE of these.
# Free: Groq (console.groq.com > API Keys). No credit card.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Paid: Claude (console.anthropic.com). Used instead of Groq if set.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Google sign-in for crew leads (Supabase > Connect)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=

# Passwords for the owner (aidenreyes27@berkeley.edu) and counter@burritobarrio.com
# Defaults to barrio-demo-2026 if left blank
DEMO_PASSWORD=
OWNER_PASSWORD=
STAFF_PASSWORD=

PORT=3001
