# Copy to .env and fill in. Never commit .env.

# AI end-of-day brief: set ONE of these.
# Free: Groq (console.groq.com > API Keys). No credit card.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Paid: Claude (console.anthropic.com). Used instead of Groq if set.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Google sign-in for crew leads (Supabase > Connect)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=

# Password for the counter tablet (counter@burritobarrio.com).
# The owner (aidenreyes27@berkeley.edu) signs in with Google. Defaults to barrio-demo-2026.
STAFF_PASSWORD=

PORT=3001
