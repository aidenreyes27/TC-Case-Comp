{
  "name": "burrito-barrio",
  "version": "1.0.0",
  "description": "Group ordering with capacity-limited pickup slots for Burrito Barrio",
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,green \"npm:api\" \"npm:web\"",
    "api": "node --watch server/index.js",
    "web": "vite",
    "build": "vite build",
    "test": "node --test \"server/*.test.js\"",
    "demo": "vite build && node server/index.js --serve-web",
    "tunnel": "cloudflared tunnel --url http://localhost:3001"
  },
  "license": "ISC",
  "dependencies": {
    "@supabase/supabase-js": "^2.119.2",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.7.0",
    "cloudflared": "^0.7.3",
    "concurrently": "^10.0.7",
    "postcss": "^8.5.33",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.6",
    "recharts": "^2.15.4",
    "tailwindcss": "^3.4.19",
    "vite": "^5.4.21"
  },
  "type": "module",
  "private": true
}